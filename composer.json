{
    "name": "kipchak/driver-filecache",
    "type": "dependency",
    "description": "A File based Caching Kipchak driver (dependency) for the Kipchak API Development Kit (ADK)",
    "keywords": [
        "APIs",
        "HTTP",
        "Microservices",
        "Mamluk",
        "Cache"
    ],
    "homepage": "https://mamluk.net",
    "license": "MIT",
    "config": {
        "sort-packages": true
    },
    "autoload": {
        "psr-4": {
            "Kipchak\\Driver\\Filecache\\": "src/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "symfony/cache": "^8",
        "kipchak/core": "^2 || ^3"
    },
    "extra": {
        "kipchak": {
            "type": "driver",
            "config": null,
            "configName": null,
            "initialise": "\\Kipchak\\Driver\\Filecache\\Filecache::initialise($container);",
            "after": [
                "kipchak/driver-config",
                "kipchak/driver-logger"
            ],
            "before": [],
            "docs": "https://kipchak.dev/docs/driver-filecache"
        }
    }
}
